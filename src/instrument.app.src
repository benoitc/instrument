{application, instrument,
 [{description, "Fast metrics library for Erlang with Prometheus export and OpenTelemetry support"},
  {vsn, "2.0.0"},
  {registered, [instrument_sup, instrument_table_owner, instrument_registry,
                instrument_exporter, instrument_metrics_exporter,
                instrument_log_exporter, instrument_span_processor,
                instrument_tracer_pool, instrument_flight_recorder]},
  {mod, {instrument_app, []}},
  {applications, [kernel, stdlib, hackney]},
  {env,[]},
  {modules, []},
  {maintainers, ["Benoit Chesneau"]},
  {licenses, ["MIT"]},
  {links, [{"GitHub", "https://github.com/benoitc/instrument"}]},
  {files, ["rebar.config",
           "do_cmake.sh",
           "do_build.sh",
           "README.md",
           "LICENSE",
           "NOTICE",
           "CHANGELOG.md",
           "src",
           "include",
           "c_src"]}
]}.
